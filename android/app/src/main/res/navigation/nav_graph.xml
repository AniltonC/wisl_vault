<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ConectionActivity">

    <fragment
        android:id="@+id/ConectionActivity"
        android:name="com.wislvault.ConectionActivity"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_ConectionActivity_to_VaultActivity"
            app:destination="@id/VaultActivity" />
    </fragment>

    <fragment
        android:id="@+id/VaultActivity"
        android:name="com.wislvault.VaultActivity"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_second">

        <argument
            android:name="serverUrl"
            app:argType="string" />

        <action
            android:id="@+id/action_VaultActivity_to_TransfersActivity"
            app:destination="@id/TransfersActivity" />
    </fragment>

    <fragment
        android:id="@+id/TransfersActivity"
        android:name="com.wislvault.TransfersActivity"
        android:label="@string/transfers_title"
        tools:layout="@layout/activity_transfers" />

</navigation>
