<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ConnectionFragment">

    <fragment
        android:id="@+id/ConnectionFragment"
        android:name="com.wislvault.ConnectionFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_connection">

        <action
            android:id="@+id/action_ConnectionFragment_to_VaultFragment"
            app:destination="@id/VaultFragment" />
    </fragment>

    <fragment
        android:id="@+id/VaultFragment"
        android:name="com.wislvault.VaultFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_vault">

        <argument
            android:name="serverUrl"
            app:argType="string" />

        <action
            android:id="@+id/action_VaultFragment_to_TransfersFragment"
            app:destination="@id/TransfersFragment" />
    </fragment>

    <fragment
        android:id="@+id/TransfersFragment"
        android:name="com.wislvault.TransfersFragment"
        android:label="@string/transfers_title"
        tools:layout="@layout/fragment_transfers" />

</navigation>
